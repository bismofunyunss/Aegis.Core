<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <SupportedOSPlatformVersion>10.0.26100.0</SupportedOSPlatformVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="BouncyCastle.Cryptography" Version="2.7.0-beta.98" />
    <PackageReference Include="Konscious.Security.Cryptography.Argon2" Version="1.3.1" />
    <PackageReference Include="Microsoft.IO.RecyclableMemoryStream" Version="3.0.1" />
    <PackageReference Include="Microsoft.TSS" Version="2.1.1" />
    <PackageReference Include="Otp.NET" Version="1.4.1" />
    <PackageReference Include="Sodium.Core" Version="1.4.1" />
    <PackageReference Include="System.Management" Version="11.0.0-preview.4.26230.115" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="11.0.0-preview.6.26359.118" />
  </ItemGroup>

  <ItemGroup>
    <Folder Include="Session\" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="Aegis.Contracts">
      <HintPath>..\..\Aegis.Contracts\Aegis.Contracts\bin\Debug\net10.0\Aegis.Contracts.dll</HintPath>
    </Reference>
  </ItemGroup>

</Project>
